rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'docimusa@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAnonymousStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function validMaintenanceReport(reportId) {
      return request.resource.data.keys().hasAll([
          'roomId', 'category', 'description', 'priority', 'status',
          'createdAt', 'resolvedAt', 'photoAvailable', 'reportedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'roomId', 'category', 'description', 'priority', 'status',
          'createdAt', 'resolvedAt', 'photoAvailable', 'reportedBy'
        ])
        && request.resource.data.roomId is int
        && request.resource.data.roomId >= 0
        && request.resource.data.roomId < 4
        && request.resource.data.category in [
          'bathroom', 'electrical', 'climate', 'furniture', 'cleaning', 'other'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.priority in ['normal', 'urgent']
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.resolvedAt == null
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.photoAvailable is bool
        && (
          !request.resource.data.photoAvailable
          || (
            exists(/databases/$(database)/documents/apps/pulizieAdmin/maintenancePhotos/$(reportId))
            && get(/databases/$(database)/documents/apps/pulizieAdmin/maintenancePhotos/$(reportId)).data.reportedBy
              == request.auth.uid
          )
        );
    }

    function validMaintenancePhoto() {
      return request.resource.data.keys().hasAll(['photoData', 'reportedBy', 'createdAt'])
        && request.resource.data.keys().hasOnly(['photoData', 'reportedBy', 'createdAt'])
        && request.resource.data.photoData is string
        && request.resource.data.photoData.size() <= 500000
        && request.resource.data.photoData.matches('^data:image/jpeg;base64,[A-Za-z0-9+/]+=*$')
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    function validMaintenanceStatusUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolvedAt'])
        && request.resource.data.status in ['open', 'resolved']
        && (
          request.resource.data.resolvedAt == null
          || request.resource.data.resolvedAt == request.time
        );
    }

    function validStockProduct() {
      return request.resource.data.keys().hasAll(['name', 'active', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
          'name', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time;
    }

    function activeStockProductExists(productId, productName) {
      return exists(/databases/$(database)/documents/apps/pulizieAdmin/stockProducts/$(productId))
        && get(/databases/$(database)/documents/apps/pulizieAdmin/stockProducts/$(productId)).data.active == true
        && get(/databases/$(database)/documents/apps/pulizieAdmin/stockProducts/$(productId)).data.name == productName;
    }

    function validStockReport(reportId) {
      return request.resource.data.keys().hasAll([
          'productId', 'productName', 'custom', 'status', 'note',
          'createdAt', 'updatedAt', 'reportedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'productId', 'productName', 'custom', 'status', 'note',
          'createdAt', 'updatedAt', 'reportedBy', 'restockedAt', 'restockedBy'
        ])
        && request.resource.data.productId == reportId
        && request.resource.data.productName is string
        && request.resource.data.productName.size() > 0
        && request.resource.data.productName.size() <= 80
        && request.resource.data.custom is bool
        && request.resource.data.status in ['low', 'out']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.updatedAt == request.time
        && request.resource.data.reportedBy == request.auth.uid
        && (
          request.resource.data.custom
          || activeStockProductExists(reportId, request.resource.data.productName)
        );
    }

    function validStockState(stateId) {
      return request.resource.data.keys().hasAll([
          'productId', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'productId', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.productId == stateId
        && request.resource.data.status in ['low', 'out', 'ok']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time;
    }

    function validStaffStockStateCreate(stateId) {
      return validStockState(stateId)
        && request.resource.data.status in ['low', 'out']
        && request.resource.data.createdAt == request.time;
    }

    function validStaffStockStateUpdate(stateId) {
      return validStockState(stateId)
        && request.resource.data.status in ['low', 'out']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'createdAt', 'updatedAt'])
        && (
          request.resource.data.status == 'out'
          || resource.data.status == 'low'
            && request.resource.data.status == 'low'
          || resource.data.status == 'ok'
            && request.resource.data.status == 'low'
            && request.resource.data.createdAt == request.time
        )
        && (
          request.resource.data.createdAt == resource.data.createdAt
          || resource.data.status == 'ok'
            && request.resource.data.createdAt == request.time
        );
    }

    match /apps/pulizie {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /apps/pulizieAdmin/cleanings/{cleaningId} {
      allow read, write: if isAdmin();
    }

    match /apps/pulizieAdmin/blocked/{blockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /apps/pulizieAdmin/maintenanceReports/{reportId} {
      allow create: if (isAnonymousStaff() || isAdmin())
        && validMaintenanceReport(reportId);
      allow read: if isAdmin();
      allow update: if isAdmin() && validMaintenanceStatusUpdate();
      allow delete: if false;
    }

    match /apps/pulizieAdmin/maintenancePhotos/{reportId} {
      allow create: if (isAnonymousStaff() || isAdmin())
        && validMaintenancePhoto();
      allow read: if isAdmin();
      allow delete: if isAdmin()
        || (request.auth != null && resource.data.reportedBy == request.auth.uid);
      allow update: if false;
    }

    match /apps/pulizieAdmin/cleaningArchive/{dateId} {
      allow read, write: if isAdmin();
    }

    match /apps/pulizieAdmin/stockProducts/{productId} {
      allow read: if isAdmin()
        || (isAnonymousStaff() && resource.data.active == true);
      allow create, update: if isAdmin() && validStockProduct();
      allow delete: if false;
    }

    match /apps/pulizieAdmin/stockReports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAnonymousStaff()
        && validStockReport(reportId)
        && request.resource.data.createdAt == request.time;
      allow update: if isAnonymousStaff()
        && validStockReport(reportId)
        && (
          request.resource.data.createdAt == resource.data.createdAt
          || resource.data.status == 'restocked'
            && request.resource.data.createdAt == request.time
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'productName', 'custom', 'status', 'note',
            'updatedAt', 'reportedBy', 'createdAt'
          ])
        && (
          request.resource.data.status == 'out'
          || resource.data.status == 'low'
            && request.resource.data.status == 'low'
          || resource.data.status == 'restocked'
            && request.resource.data.status in ['low', 'out']
        );
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /apps/pulizieAdmin/stockStates/{stateId} {
      allow get: if isAdmin() || isAnonymousStaff();
      allow list: if isAdmin();
      allow create: if (isAdmin() && validStockState(stateId))
        || (isAnonymousStaff() && validStaffStockStateCreate(stateId));
      allow update: if (isAdmin() && validStockState(stateId))
        || (isAnonymousStaff() && validStaffStockStateUpdate(stateId));
      allow delete: if false;
    }

    match /apps/pulizieAdmin/stockHistory/{historyId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
