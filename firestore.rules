rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'docimusa@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /apps/pulizie {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /apps/pulizieAdmin/cleanings/{cleaningId} {
      allow read, write: if isAdmin();
    }

    match /apps/pulizieAdmin/blocked/{blockId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
